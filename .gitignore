# python缓存
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# 日志
logs/

# 运行时生成的配置（白名单配置，不提交到仓库）
config/

# 图表输出目录（可选功能生成的图表）
outputs/

# 测试输出文件（导出结果、临时脚本）
tests/**/*.json
tests/**/*.csv
tests/**/*.png
*.output.json

# 分析产物：临时结果转储目录（不应提交，也不应长期留在项目根目录）
analysis_out/

# 环境、密钥
.env
*.env

# vscode/pycharm IDE
.venv/
venv/
.idea/
.vscode/
*.swp
*.swo

# 临时文件
*.tmp
tmp_*.py
